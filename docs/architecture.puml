package output {
  class OutputBlock
  class Dither {
    +quantize(x) / process(x*, n) : TPDF, onto 2^(bits-1)
  }
}
Dither *-- "2" Noise : (D1) the triangle
package spectral {
  class FFT {
    +FFT(n) : a power of two
    +forward(data*) / inverse(data*) : in place, (F1)-(F3)
  }
  class TimeStretch <<function>> {
    +timeStretch(channels, rate, StretchParams) : ratio x as long, pitch x 2^(s/12)
    +resample(in, step, frames) : Kaiser-windowed sinc, (R1)-(R3)
    (P1)-(P8): phase vocoder, identity phase locking, a time map rigid around onsets
  }
}
TimeStretch ..> FFT
TimeStretch ..> Onsets : (P6) where attacks are
package resample {
  class SincKernel {
    +SincKernel(cutoff, zeroCrossings, beta, perSample)
    +operator()(t) : (R2) Kaiser-windowed sinc, (R3) tabulated
  }
  class AdaptiveResampler {
    +inputNeeded(outFrames, step) : (A3) exactly
    +process(in*, inFrames, out*, outFrames, step) : (A1)-(A2), a step free to change each block
    +buffered() : (A5) / lookahead() : (A4) R
  }
  class FillController {
    +update(fill, frames) : (F1)-(F3) the step's deviation
    +driftPpm() : (F5) / setTarget(t) : (F6) ramped / reset(fill, driftPpm)
  }
}
TimeStretch ..> SincKernel : resample's kernel (REQ-resample-1)
AdaptiveResampler *-- SincKernel
FillController ..> AdaptiveResampler : steers its step (a host wires them)
package meter {
  class LoudnessMeter {
    +process(left*, right*, frames)
    +momentary() / shortTerm() / integrated() : LUFS
  }
  class Onsets <<function>> {
    +detectOnsets(mono*, frames, rate, OnsetParams) : samples
    +estimateTempo(mono*, frames, rate, TempoParams) : bpm, 0 none
    (O1)-(O5): energy flux over a local median, refined to the sample
    (B1)-(B5): a smoothed log flux, autocorrelated, weighted to 120 bpm
  }
  class Tuner {
    +setReferenceHz
    +process(io**, ch, frames) : (Y0) listens, untouched
    +reading(i) : frequency, note, cents, level (atomics)
  }
  class TruePeakInterpolator {
    +push(history, x) : the most of its points
    factor 4 (BS.1770) | 8 onSamples (the limiter)
  }
  class TruePeakMeter {
    +process(left*, right*, frames)
    +peakDb() / lastBlockDb() : dBTP, 4x
  }
  class CorrelationMeter {
    +correlation() : -1..+1
  }
  class SpectrumAnalyser {
    +bandHz(b) / bandDb(b) : 61 bands, 1/6 oct
  }
  class KWeighting
  LoudnessMeter *-- KWeighting
  SpectrumAnalyser *-- "61" Biquad : band-passes
}
package functional {
  class ProcessorRepeater<T>
}
package physical {
  class LongitudinalBank {
    + setFundamentalHz / setTensionCoupling
    + firstModeHz(f0) / registerGainFor(f0)
    ' longitudinal modes -> phantom partials (README ## 12)
  }
  class StringResonator {
    + setFrequencyHz(hz) / setDecaySeconds(t60)
    ' matched-Z 2-pole resonator: y[n]=2r*cos(th)*y[n-1]-r^2*y[n-2]+G*x[n]
  }
  class StringPartialBank {
    + setFundamentalHz / setInharmonicity(B)
    + setBaseDecaySeconds / setBrightnessDecaySeconds(t60@5k)
    + setStrikePosition(beta) / setDamperEngagement(d) / setDamperEngageMs
    + pluck(A, f_p)   ' README §14: released from rest, A_n = A|sin n pi beta|/n
    - mPartials : StringResonator[N]   ' f_n = n*f0*sqrt(1+B*n^2)
  }
  class HammerExciter {
    + strike(velocity) / setMass / setStiffness
    + setNonlinearExponent(p) / setHysteresisLoss(eps)
    ' nonlinear compression spring, asymmetric load/unload
  }
  class PianoBridge {
    + accumulate(Sample) / tick() / feedback() / radiatedOutput()
    + setCouplingGain / setRadiationGain
    - mModes : StringResonator[M]   ' soundboard body modes, shared bus
  }
  class PianoVoice {
    + setUnisonCount / setUnisonDetuneCents
    + setUnaCorda(bool) / setDamperHeld(bool)
    + setBridge(PianoBridge*)
    + silence()   ' a host's seek: silent now, as made
    # generate(channel) : Sample   ' hammer -> unison strings -> bridge push/pull
  }
  class PianoEngine {
    + noteOnMidi(note, vel) / noteOff(note) / releaseAll() / silence()
    + setSustainPedal / setSostenutoPedal / setUnaCorda
    + setTuning(row, value)   ' the voicing bank (Tune)
    + renderAdd(out, ch, frames, gain) / renderBlockFloat / renderBlockBytes
    - 16 voices; steals: never used, finished, longest released, oldest held (REQ-inst-piano-1)
  }
}
note bottom of physical
