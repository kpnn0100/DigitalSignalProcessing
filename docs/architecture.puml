package compute {
  interface ParallelExecutor {
    + run(task, ctx, shards)   ' blocking, no allocation
    + concurrency()
    + shouldParallelise(frames)
  }
  class SerialExecutor {
    ' default; the reference for bit-identity
  }
  class ThreadPoolExecutor {
    + workerCount()
    ' persistent workers; lock-free shard claiming
  }
  class ComputeConfig <<singleton>> {
    + executor() / setExecutor(e)
  }
}
ParallelExecutor <|-- SerialExecutor
ParallelExecutor <|-- ThreadPoolExecutor
ComputeConfig o--> ParallelExecutor : active
