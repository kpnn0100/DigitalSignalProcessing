@startuml arstro_architecture
'  Arstro DSP Library — architecture (channel-aware synth subset of synth_dsp.h).
'  This diagram is the design surface: keep it in sync with the code (see
'  .claude/skills/implement_with_sync_and_test). Spatial modules are legacy
'  (not migrated to the channel-aware base) and shown separately.
title Arstro DSP — Class Architecture (v1.0.0)

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

' ─────────────────────────── Foundation ───────────────────────────
package base {
  class AudioConfig <<singleton>> {
    + {static} instance() : AudioConfig&
    + sampleRate() : Sample
    + bufferSize() : int
    + channelCount() : int
    + outputBitDepth() : int
    + setSampleRate(Sample)
    + setChannelCount(int)
  }

  abstract class SignalProcessor {
    + out(in : Sample, channel : int) : Sample
    + {abstract} process(in : Sample, channel : int) : Sample
    + update()
    + onChannelCountChanged()
    + setProperty(id, value)
    + getProperty(id) : Sample  ' smoothed
    - mParams : ParameterSet
  }

  class SmoothedParameter {
    + last / target / current : Sample
    + setTarget(v) : bool
    + beginRamp()
    + interpolate(ratio)
    + snap()
  }
  class ParameterSet {
    + init(id, v) / setTarget(id, v)
    + current(id) / target(id) : Sample
    + beginRamp() / interpolate(ratio) / snapAll()
  }

  class Block {
    - mChains : vector<vector<SignalProcessor*>>
    + add(p) / add(p, channel)
    + setIsParallel(bool)
  }
  class FeedbackBlock
  abstract class SignalGenerator {
    + noteOn(velocity) / noteOff()
    + setFrequency(hz)
    + {abstract} generate(channel) : Sample
    # mEnvelope : ADSREnvelope
  }
  class CircularList<T>
  class LockFreeQueue<T> <<SPSC, lock-free>>
}

package util {
  interface IPropertyChangeListener
}

SignalProcessor *--> "1" ParameterSet
ParameterSet o--> "*" SmoothedParameter
SignalProcessor ..> AudioConfig : reads global config
SignalProcessor --> IPropertyChangeListener : notifies
Block --|> SignalProcessor
FeedbackBlock --|> SignalProcessor
SignalGenerator --|> SignalProcessor

' ─────────────────────────── Modules ───────────────────────────
package device {
  class ParamSpec {
    name, label, unit
    min, max, def, choices
    +clamp(v)
  }
  class DeviceType {
    name, label, kind, params
    noteNames / notePrefixes : a kit's keys, named and joined to their parameters (REQ-device-6/9)
    groupLabels : a title per parameter group (REQ-device-10)
    +create()
  }
  abstract class Device {
    +process(io**, ch, frames)
    +setParam(i|name, v) : clamped
    +noteOn / noteOff / reset
    +latency() : samples its output lags (REQ-device-8)
    +setTransport(Transport) : where the song is, before a block (REQ-device-12)
    #apply(i, v)
  }
  class DeviceRegistry <<static>> {
    +types() / find(name) / create(name)
  }
  class ParamMapping <<functions>> {
    +normalizedFromValue(spec, v) / valueFromNormalized(spec, n)
    +paramSteps(spec)
    +paramToText(spec, v) / paramFromText(spec, text, &v)
  }
}
package vst3 <<apps/vst3>> {
  class Processor {
    AudioEffect: notes in, stereo out
    +process() : split at every offset
    +getState / setState : text
    +notify("arstro.note") : an editor's note, queued lock-free (REQ-vst-7)
  }
  class Controller {
    EditController
    +setComponentState()
    +createView("editor") : createEditor(*this) when ARSTRO_VST3_EDITOR (REQ-vst-6)
    +type() / plainValue(i)
    +editBegin / editPerform(plain) / editEnd : normalizedFromValue
    +playNote(pitch, vel) : a message to the processor (REQ-vst-7)
  }
  note right of Controller : Editor.h — the seam; the editor is the umbrella's (Solaris R-VST-7)
  class RegistryParameter {
    Parameter: toPlain / toNormalized / toString / fromString
  }
}
package instrument {
  interface Instrument {
    +noteOn(note, vel) / noteOff(note)
    +allNotesOff() / reset()
    +render(out**, channels, frames) : ADDS
    +activeVoices()
    +pitchBend(-1..1) / modWheel(0..1) : ignored by default
  }
  class BasicSynth {
    +setParams(Params)  -- mode poly|mono|legato, glide, bendRange, vibrato; an Osc's table, position, posEnv
    +setWavetable(mono, frames)  -- the "sample" table (REQ-wavetable-3)
    +oscFrequency(k, pitch) / cutoffFor(note, env) / voicePitch(v)
    -(Y7) pitch on an absolute 32-sample grid
    -16 voices: 2 Oscillator, SVF, 2 ADSR, Noise
  }
  class FMSynth {
    +setParams(Params)  -- algorithm 1..8, feedback, 4 Op: ratio, fine, level, ADSR, velocity
    +modulates(a, j, k) / carrier(a, k)  -- (M3)
    -(M1)-(M2) operators 4 -> 1, phase modulation, index 8 rad; the 32-sample pitch grid
  }
  FMSynth ..|> Instrument
  FMSynth *-- "64" ADSREnvelope : 16 voices x 4 operators
  class Bass808 {
    +setParams(punch, punchTime, glide, decay, click, drive, tone)  -- mono
    -(B1) a punch down to the note, a linear glide; (B4) tanh drive normalised; ends at its exact sample
  }
  Bass808 ..|> Instrument
  Bass808 *-- Phasor
  Bass808 *-- DecayEnvelope
  Bass808 *-- Noise : the click
  Bass808 ..> Biquad : design() for its tone
  class Guitar {
    +setParams(position, pick, sustain, brightness, stiffness, body, mute, release)  -- 8 strings
    -(GT2) T60_1 = sustain*(f_E2/f0)^0.5; (GT7) a voice ends on its own clock
  }
  Guitar ..|> Instrument
  Guitar *-- "8" StringPartialBank : pluck() — README §14
  Guitar *-- "3" StringResonator : the body
  class GranularSampler {
    +setSample(frames) / setParams(size, density, position, scan, spray, pitch, spread)
    -(G1) a grain every fs/density from the note; (G3) Hann; (G4) the overlap divided out
  }
  GranularSampler ..|> Instrument
  class MultiSampler {
    +setDefinition(SfzInstrument) / setSound(name, frames)  -- the host's, at build
    -(Z2) regions by key, velocity, round robin, chance; (Z4) loops; (Z6) choke
  }
  class Sfz <<function>> {
    +parseSfz(text) : SfzInstrument  -- (Z1) inheritance, key names
    +sfzSounds(sfz) / sfzKey(name)
  }
  MultiSampler ..|> Instrument
  MultiSampler ..> Sfz
  class DrumMachine {
    +setPad(Pad, PadParams)
    +noteFor(Pad) / padFor(note)
    -10 pads: Phasor×6, Noise, DecayEnvelope×3, SVF×2
  }
  class Sampler {
    +setSample(frames*, n, ch, rate) : a copy
    +setParams(mode, root, span, reverse, ADSR, level, velocity, slices)
    -16 voices: interpolated playback, ADSREnvelope
    -slices (S7): key root+k plays part k of the span
  }
  class Piano {
    +setParams(tune[15], sustain, soft, volumeDb)
    -(P1) velocity v/127 · (P2) volume after the limiter · (P3) stop = keys up, seek = silence
  }
}
package generator {
  class Phasor <<value type>> {
    +advance(inc) / sine(inc) / square(inc)
  }
  class Noise <<value type>> {
    +setSeed(s) / next() : [-1,1)
  }
  enum Waveform
  class Oscillator {
    +setWaveform(Waveform)  -- Table reads a Wavetable
    +setTable(Wavetable*) / setPosition(p, ramp)  -- (W7)
  }
  class Wavetable {
    +Wavetable(cycles)  -- (W1) nine levels by the FFT
    +read(phase, position, dt)  -- (W2)-(W4) no alias
    +builtIn(i) / fromSample(mono, frames)  -- (W5), (W6)
  }
  Oscillator ..> Waveform
  Oscillator ..> Wavetable : Table
  Wavetable ..> FFT : (W1)
}
package envelope {
  class ADSREnvelope
  class DecayEnvelope <<value type>> {
    +trigger(peak) / next() / choke(ms)
  }
}
package simpleProcessor {
  class Gain
  class Delay
}
package equalizer {
  class LowPassFilterBase
  class LowPassFilter
  class HighPassFilterBase
  class HighPassFilter
  class Biquad {
    +design(type, hz, q, gainDb, fs) : Coeffs
    +magnitudeDb(Coeffs, hz, fs)
    -mZ1, mZ2 : per-channel TDF-II
  }
  class ParametricEQ {
    +band(i) : Biquad&
    +setBandEnabled(i, on)
    +magnitudeDbAt(hz)
  }
  class StateVariableFilter {
    +tick(in, ch, cutoffHz)
    +qFor(resonance)
    -mIc1, mIc2 : per-channel
  }
}
package reverb {
  class Reverb {
    + setDelayInMs / setDecayInMs / setMix(0..1)
    + setWidth(0..1)   ' stereo decorrelation
    + setLowCutFrequency / setHighCutFrequency
    - bsReverb : BasicReverb[channel]  ' per-channel FDN, delay decorrelated by width
  }
}
note bottom of Reverb
  Natural stereo: each channel's FDN base delay is
  spread by width (kStereoSpread=0.15) so a mono
  input yields decorrelated L/R tails.
  width=0 => identical channels (mono).
end note
package effects {
  class Compressor {
    +setSidechain(on) / setKey(key**, ch) : detector on the key
  }
  class Limiter {
    +setGainDb / setCeilingDb / setReleaseMs / setLookaheadMs
    +setTruePeak(on) : (L6) between samples, latency L+16
    +process(io**, ch, frames) : linked, lookahead
    +latency() / clamped()
  }
  class MultibandCompressor {
    +setSplits(f1, f2) / setThresholdDb|setRatio|setGainDb(band, ..)
    +process(io**, ch, frames) : (MB1)-(MB4) LR4 bands, flat at ratio 1
  }
  MultibandCompressor *-- "3" Compressor
  MultibandCompressor ..> Biquad : design() for its crossovers
  class Gate {
    +setThresholdDb / setRatio / setRangeDb / setAttackMs / setHoldMs / setReleaseMs
    +setSidechain(on) / setKey(key**, ch)
    +process(io**, ch, frames) : (GT1)-(GT5) linked, held, eased in dB
  }
  class TransientShaper {
    +setAttack(pct) / setSustain(pct) / setOutputDb
    +process(io**, ch, frames) : (TS1)-(TS5) e_f against e_r (up only) and e_s (down only)
  }
  class DeEsser {
    +setFrequency / setThresholdDb / setRangeDb / setSplit(on)
    +process(io**, ch, frames) : (DE1)-(DE5) HP-heard, held at T, shelved (split) or wide
  }
  DeEsser ..> Biquad : design() its band and its shelf
  class Saturator {
    +setDriveDb / setCurve(soft|hard|tube|fold) / setMix / setOutputDb
    +process(io**, ch, frames) : (SA1)-(SA6) 4x up, the curve, down
    +latency() : 15
    +{static} shape(curve, u)
  }
  Saturator ..> TruePeakInterpolator : its taps, the way up
  class Bitcrusher {
    +setBits / setRate / setMix / setOutputDb
    +process(io**, ch, frames) : (BC1)-(BC3) the grid, the hold
  }
  class Vowel {
    +setVowel / setShift / setResonance / setMix / setOutputDb / setGlideMs
    +process(io**, ch, frames) : (VW1)-(VW5) three formants, morphed, summed
    +{static} formantHz(v, k, shift)
  }
  Vowel ..> Biquad : design(BandPass) per formant
  class Shaper {
    +setRate / setShape / setDepth / setPhase / setStereo / setSmoothMs
    +setTransport(sample, samplesPerBeat, beatOffset) : REQ-device-12
    +process(io**, ch, frames) : (SH1)-(SH5) the song's beat, a shape, a glide
    +{static} shapeAt(shape, φ) / beatsOfRate(rate)
  }
  class Phaser {
    +setStages / setRateHz / setCenterHz / setDepthOct / setFeedback / setStereoDeg / setMix
    +process(io**, ch, frames) : (PH1)-(PH4) all-passes swept, fed back, mixed
    +{static} coefficient(hz, fs)
  }
  class Flanger {
    +setDelayMs / setDepthMs / setRateHz / setFeedback / setStereoDeg / setMix
    +process(io**, ch, frames) : (FL1)-(FL3) a Delay swept, fed back, mixed
  }
  class Imager {
    +setWidth(pct) / setMono(on) / setMonoHz
    +process(io**, ch, frames) : (IM1)-(IM4) mid/side, LR4 side high-pass + mid all-pass
  }
  class Convolver {
    +setSample(interleaved*, frames, channels, rate) : (CV1)-(CV3) allocates
    +setMix / setLevelDb
    +process(io**, ch, frames) : (CV4)-(CV6) partitioned overlap-save
    +latency() : 256
  }
  class PitchShifter {
    +setSemitones / setCents / setWindowMs / setMix
    +process(io**, ch, frames) : (PS2)-(PS5) two taps sweeping a Delay, crossfaded
    +latency() : 1 + W/2
  }
  class Vocoder {
    +setBands / setLowHz / setHighHz / setAttackMs / setReleaseMs / setMix / setOutputDb
    +setKey(key**, ch) : the carrier
    +process(io**, ch, frames) : (VO1)-(VO5) band envelopes of the input times the key's bands
  }
  class Overdrive
  class Chorus
  class Repeater
}
