@startuml arstro_architecture
'  Arstro DSP Library — architecture (channel-aware synth subset of synth_dsp.h).
'  This diagram is the design surface: keep it in sync with the code (see
'  .claude/skills/implement_with_sync_and_test). Spatial modules are legacy
'  (not migrated to the channel-aware base) and shown separately.
title Arstro DSP — Class Architecture (v1.0.0)

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

' ─────────────────────────── Foundation ───────────────────────────
package base {
  class AudioConfig <<singleton>> {
    + {static} instance() : AudioConfig&
    + sampleRate() : Sample
    + bufferSize() : int
    + channelCount() : int
    + outputBitDepth() : int
    + setSampleRate(Sample)
    + setChannelCount(int)
  }

  abstract class SignalProcessor {
    + out(in : Sample, channel : int) : Sample
    + {abstract} process(in : Sample, channel : int) : Sample
    + update()
    + onChannelCountChanged()
    + setProperty(id, value)
    + getProperty(id) : Sample  ' smoothed
    - mParams : ParameterSet
  }

  class SmoothedParameter {
    + last / target / current : Sample
    + setTarget(v) : bool
    + beginRamp()
    + interpolate(ratio)
    + snap()
  }
  class ParameterSet {
    + init(id, v) / setTarget(id, v)
    + current(id) / target(id) : Sample
    + beginRamp() / interpolate(ratio) / snapAll()
  }

  class Block {
    - mChains : vector<vector<SignalProcessor*>>
    + add(p) / add(p, channel)
    + setIsParallel(bool)
  }
  class FeedbackBlock
  abstract class SignalGenerator {
    + noteOn(velocity) / noteOff()
    + setFrequency(hz)
    + {abstract} generate(channel) : Sample
    # mEnvelope : ADSREnvelope
  }
  class CircularList<T>
  class LockFreeQueue<T> <<SPSC, lock-free>>
}

package util {
  interface IPropertyChangeListener
}

SignalProcessor *--> "1" ParameterSet
ParameterSet o--> "*" SmoothedParameter
SignalProcessor ..> AudioConfig : reads global config
SignalProcessor --> IPropertyChangeListener : notifies
Block --|> SignalProcessor
FeedbackBlock --|> SignalProcessor
SignalGenerator --|> SignalProcessor

' ─────────────────────────── Modules ───────────────────────────
package device {
  class ParamSpec {
    name, label, unit
    min, max, def, choices
    +clamp(v)
  }
  class DeviceType {
    name, label, kind, params
    +create()
  }
  abstract class Device {
    +process(io**, ch, frames)
    +setParam(i|name, v) : clamped
    +noteOn / noteOff / reset
    #apply(i, v)
  }
  class DeviceRegistry <<static>> {
    +types() / find(name) / create(name)
  }
}
package instrument {
  interface Instrument {
    +noteOn(note, vel) / noteOff(note)
    +allNotesOff() / reset()
    +render(out**, channels, frames) : ADDS
    +activeVoices()
  }
  class BasicSynth {
    +setParams(Params)
    +oscFrequency(k, note) / cutoffFor(note, env)
    -16 voices: 2 Oscillator, SVF, 2 ADSR, Noise
  }
  class DrumMachine {
    +setPad(Pad, PadParams)
    +noteFor(Pad) / padFor(note)
    -10 pads: Phasor×6, Noise, DecayEnvelope×3, SVF×2
  }
}
package generator {
  class Phasor <<value type>> {
    +advance(inc) / sine(inc) / square(inc)
  }
  class Noise <<value type>> {
    +setSeed(s) / next() : [-1,1)
  }
  enum Waveform
  class Oscillator {
    +setWaveform(Waveform)
  }
  Oscillator ..> Waveform
}
package envelope {
  class ADSREnvelope
  class DecayEnvelope <<value type>> {
    +trigger(peak) / next() / choke(ms)
  }
}
package simpleProcessor {
  class Gain
  class Delay
}
package equalizer {
  class LowPassFilterBase
  class LowPassFilter
  class HighPassFilterBase
  class HighPassFilter
  class Biquad {
    +design(type, hz, q, gainDb, fs) : Coeffs
    +magnitudeDb(Coeffs, hz, fs)
    -mZ1, mZ2 : per-channel TDF-II
  }
  class ParametricEQ {
    +band(i) : Biquad&
    +setBandEnabled(i, on)
    +magnitudeDbAt(hz)
  }
  class StateVariableFilter {
    +tick(in, ch, cutoffHz)
    +qFor(resonance)
    -mIc1, mIc2 : per-channel
  }
}
package reverb {
  class Reverb {
    + setDelayInMs / setDecayInMs / setMix(0..1)
    + setWidth(0..1)   ' stereo decorrelation
    + setLowCutFrequency / setHighCutFrequency
    - bsReverb : BasicReverb[channel]  ' per-channel FDN, delay decorrelated by width
  }
}
note bottom of Reverb
  Natural stereo: each channel's FDN base delay is
  spread by width (kStereoSpread=0.15) so a mono
  input yields decorrelated L/R tails.
  width=0 => identical channels (mono).
end note
package effects {
  class Compressor
  class Overdrive
  class Chorus
  class Repeater
}
package output {
  class OutputBlock
}
package functional {
  class ProcessorRepeater<T>
}
package physical {
  class LongitudinalBank {
    + setFundamentalHz / setTensionCoupling
    + firstModeHz(f0) / registerGainFor(f0)
    ' longitudinal modes -> phantom partials (README ## 12)
  }
  class StringResonator {
    + setFrequencyHz(hz) / setDecaySeconds(t60)
    ' matched-Z 2-pole resonator: y[n]=2r*cos(th)*y[n-1]-r^2*y[n-2]+G*x[n]
  }
  class StringPartialBank {
    + setFundamentalHz / setInharmonicity(B)
    + setBaseDecaySeconds / setBrightnessDecaySeconds(t60@5k)
    + setStrikePosition(beta) / setDamperEngagement(d) / setDamperEngageMs
    - mPartials : StringResonator[N]   ' f_n = n*f0*sqrt(1+B*n^2)
  }
  class HammerExciter {
    + strike(velocity) / setMass / setStiffness
    + setNonlinearExponent(p) / setHysteresisLoss(eps)
    ' nonlinear compression spring, asymmetric load/unload
  }
  class PianoBridge {
    + accumulate(Sample) / tick() / feedback() / radiatedOutput()
    + setCouplingGain / setRadiationGain
    - mModes : StringResonator[M]   ' soundboard body modes, shared bus
  }
  class PianoVoice {
    + setUnisonCount / setUnisonDetuneCents
    + setUnaCorda(bool) / setDamperHeld(bool)
    + setBridge(PianoBridge*)
    # generate(channel) : Sample   ' hammer -> unison strings -> bridge push/pull
  }
}
note bottom of physical
  See src/physical/README.md ## Math for every formula
  (REQ-piano-1..16, docs/requirements.md). No existing
  resonant/biquad primitive existed to reuse (rule 1
  reuse-check); LowPassFilter IS reused for the secondary
  hammer-thump / damper-noise bursts.
end note

StringResonator --|> SignalProcessor
StringPartialBank --|> SignalProcessor
StringPartialBank o--> "N=12" StringResonator
HammerExciter --|> SignalProcessor
PianoBridge --|> SignalProcessor
PianoBridge o--> "M=8" StringResonator : soundboard modes (reused class)
PianoVoice --|> SignalGenerator
PianoVoice *--> "U=1..3" StringPartialBank : unison strings
PianoVoice *--> "1" HammerExciter
PianoVoice o--> "shared" PianoBridge : push/pull (sympathetic coupling)
PianoVoice ..> LowPassFilter : shapes secondary noise bursts

Oscillator --|> SignalGenerator
SignalGenerator *--> ADSREnvelope
ADSREnvelope --|> SignalProcessor
Gain --|> SignalProcessor
Delay --|> SignalProcessor
Delay o--> CircularList
LowPassFilterBase --|> SignalProcessor
LowPassFilter --|> LowPassFilterBase
HighPassFilterBase --|> SignalProcessor
HighPassFilter --|> LowPassFilter
Biquad --|> SignalProcessor
ParametricEQ --|> Block
ParametricEQ *--> "7" Biquad : bands, in series
StateVariableFilter --|> SignalProcessor
BasicSynth ..|> Instrument
DeviceRegistry o--> "9" DeviceType
DeviceType o--> "*" ParamSpec
DeviceType ..> Device : creates
Device ..> BasicSynth : SynthDevice wraps
Device ..> DrumMachine : DrumDevice wraps
Device ..> Compressor : EffectDevice<Proc> wraps the effects
DrumMachine ..|> Instrument
BasicSynth *--> Oscillator : 2 per voice (gated)
BasicSynth *--> StateVariableFilter : per voice
BasicSynth *--> ADSREnvelope : amp + filter
BasicSynth *--> Noise
DrumMachine *--> Phasor
DrumMachine *--> Noise
DrumMachine *--> DecayEnvelope
DrumMachine *--> StateVariableFilter
Reverb --|> SignalProcessor
Compressor --|> SignalProcessor
Overdrive --|> SignalProcessor
Chorus --|> SignalProcessor
Repeater --|> SignalProcessor

' ─────────────────────────── Synth engine ───────────────────────────
package compute {
  interface ParallelExecutor {
    + run(task, ctx, shards)   ' blocking, no allocation
    + concurrency()
    + shouldParallelise(frames)
  }
  class SerialExecutor {
    ' default; the reference for bit-identity
  }
  class ThreadPoolExecutor {
    + workerCount()
    ' persistent workers; lock-free shard claiming
  }
  class ComputeConfig <<singleton>> {
    + executor() / setExecutor(e)
  }
}
ParallelExecutor <|-- SerialExecutor
ParallelExecutor <|-- ThreadPoolExecutor
ComputeConfig o--> ParallelExecutor : active
ThreadPoolExecutor *--> "N" Thread : platform adapter

package synth {
  class SynthEngine {
    + pushParam/pushNoteOn/pushNoteOff   ' comms thread (lock-free)
    + renderBlockBytes(out, frames)
    + renderBlockBytesParallel(out, frames)
    + beginBlock/renderVoiceShard/finishBlock  ' N-way voice split
  }
  class VoiceManager
  class Voice
}

SynthEngine *--> VoiceManager
SynthEngine *--> Block : "effects chain"
SynthEngine *--> Compressor
SynthEngine *--> Overdrive
SynthEngine *--> Chorus
SynthEngine *--> Repeater
SynthEngine *--> Reverb
SynthEngine *--> OutputBlock
SynthEngine *--> LockFreeQueue : control commands
SynthEngine ..> ComputeConfig : "picks executor per block"
VoiceManager *--> "N" Voice
Voice *--> Oscillator

' ─────────────────────────── Apps ───────────────────────────
package "apps/kitchen_sink" <<app>> {
  class RackEngine {
    + setGenerator params + ADSR
    + addNode(type) / removeNode(i) / moveNode(i,dir)
    + setNodeParam(i, p, value)
    + noteOnMidi / noteOff
    + render(interleaved, frames)
    + {static} nodeTypesJson()  ' catalogue -> UI
  }
  class "web (HTML/JS, WASM)" as WebUI <<browser>>
}
RackEngine *--> Oscillator : generator
RackEngine o--> "*" SignalProcessor : ordered effect chain
WebUI ..> RackEngine : embind (web_bindings.cpp)
note right of WebUI
  Chain builder + ADSR editor + waveform/spectrum
  scopes. Plays via Web Audio (system default out).
end note

package "apps/piano_demo" <<app>> {
  class PianoEngine {
    + noteOnMidi(note, vel) / noteOff(note)
    + setSustainPedal / setSostenutoPedal / setUnaCorda
    + render(buf, frames, channel)
  }
}
PianoEngine *--> "8" PianoVoice
PianoEngine *--> "1" PianoBridge
note right of PianoEngine
  Headless CLI + WAV render (same pattern as
  apps/kitchen_sink/main.cpp) — the "simple UI"
  to audition PianoVoice (REQ-piano-10).
end note

' ─────────────────────────── Legacy (not migrated) ───────────────────────────
package spatial <<legacy / mono process()>> {
  class Positioner
  class PositionSimulator
  class RoomSimulation
}
note bottom of spatial
  Still on the old mono process(in) signature.
  Excluded from the synth build (synth_dsp.h).
  Needs the channel-aware signature change.
end note

@enduml
